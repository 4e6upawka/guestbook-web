@page
@model IndexModel
@{ ViewData["Title"] = "Гостевая книга"; }
<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>GuestBook · Azurite</title>
<style>body{font-family:Segoe UI,Arial,sans-serif;background:#f4f6fb;color:#202b40;margin:0}main{max-width:780px;margin:36px auto;padding:0 18px}h1{margin-bottom:4px}.muted{color:#69768b}.panel,.entry{background:white;border:1px solid #e0e5ee;border-radius:14px;padding:22px;margin:18px 0;box-shadow:0 4px 16px #2233440a}label{display:block;font-weight:600;margin:12px 0 6px}input,textarea{box-sizing:border-box;width:100%;border:1px solid #cad2df;border-radius:8px;padding:11px;font:inherit}textarea{min-height:100px}button,.link{background:#285ce6;color:white;border:0;border-radius:8px;padding:10px 16px;cursor:pointer;text-decoration:none;display:inline-block}.delete{background:#c93749}.entry-head{display:flex;justify-content:space-between;gap:10px;align-items:center}.entry p{white-space:pre-wrap;overflow-wrap:anywhere}.entry img{max-width:100%;max-height:260px;border-radius:8px}.search{display:flex;gap:8px}.search input{flex:1}.search button{flex:none}.error{color:#b3261e}</style>
</head><body><main><h1>Гостевая книга</h1><div class="muted">Лабораторная №10–11 · локальное Azure Table Storage (Azurite)</div>
<p><a class="link" href="/Gallery">Галерея фотографий</a></p><section class="panel"><h2>Добавить запись</h2><div asp-validation-summary="All" class="error"></div><form method="post" enctype="multipart/form-data"><label asp-for="GuestName">Имя гостя</label><input asp-for="GuestName" maxlength="100" required/><label asp-for="Message">Сообщение</label><textarea asp-for="Message" maxlength="1000" required></textarea><label asp-for="Photo">Фото (необязательно, до 5 МБ)</label><input asp-for="Photo" type="file" accept="image/png,image/jpeg,image/webp"/><p><button type="submit">Сохранить в Azurite</button></p></form></section>
<section class="panel"><h2>Фильтр по имени</h2><form method="get" class="search"><input name="SearchName" value="@Model.SearchName" placeholder="Например, Иван"/><button type="submit">Найти</button><a class="link" asp-page="/Index">Сброс</a></form></section>
<h2>Записи (@Model.Entries.Count)</h2>
@foreach (var entry in Model.Entries) {<article class="entry"><div class="entry-head"><strong>@entry.GuestName</strong><small class="muted">@entry.PartitionKey</small></div><p>@entry.Message</p>@if (!string.IsNullOrWhiteSpace(entry.PhotoUrl) ) {<p><img src="@Url.Page("/Index", "Photo", new { name = entry.PhotoUrl })" alt="Фото гостя"/></p>}
<form method="post" asp-page-handler="Delete" onsubmit="return confirm('Удалить запись?')"><input type="hidden" name="partitionKey" value="@entry.PartitionKey"/><input type="hidden" name="rowKey" value="@entry.RowKey"/><button class="delete" type="submit">Удалить</button></form></article>}
@if (Model.Entries.Count == 0) {<p class="muted">Записей пока нет.</p>}
</main></body></html>
